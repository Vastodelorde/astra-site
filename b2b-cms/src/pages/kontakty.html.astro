---
import Layout from '../layouts/Layout.astro';
import { contactPageFallback, siteSettingsFallback } from '../data/siteContent';
import { getManagedPage, getSiteSettings } from '../lib/sanity';
import { getSection, localize, mergeContent } from '../lib/content';

export const prerender = false;
const [managedPage, managedSettings] = await Promise.all([getManagedPage('contacts'), getSiteSettings()]);
const page = mergeContent(contactPageFallback, managedPage);
const settings = mergeContent(siteSettingsFallback, managedSettings);
const seo: any = page.seo;
const contacts = getSection<any>(page, 'contacts');
const consult = getSection<any>(page, 'consult');
const [support, messengers, accounting] = contacts.items;
const t = (value: any) => localize(value, 'uk');
---
<Layout
  leadSource={t(page.hero.label)}
  title={t(seo.title)}
  description={t(seo.description)}
  canonical={seo.canonicalUk}
  ogTitle={t(seo.ogTitle) || t(seo.title)}
  ogDescription={t(seo.ogDescription) || t(seo.description)}
>
  <style is:global slot="head">
.page-b2b .contact-card{background:var(--surface);border:1px solid var(--line);border-radius:var(--r-lg);padding:28px;display:flex;flex-direction:column}
.page-b2b .contact-card h3{margin:0 0 4px}
.page-b2b .contact-card .sub{font-size:.9rem;color:var(--muted);margin:0 0 18px}
.page-b2b .phone-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column}
.page-b2b .phone-list a{display:flex;align-items:baseline;gap:12px;padding:9px 0;font-family:var(--font-display);font-weight:700;font-size:1.1rem;color:var(--navy-900);border-bottom:1px solid var(--line)}
.page-b2b .phone-list li:last-child a{border-bottom:0}
.page-b2b .phone-list a:hover{color:var(--blue-700)}
.page-b2b .phone-list .ico{width:17px;height:17px;flex:none;align-self:center;color:var(--red)}
.page-b2b .phone-list .tag{font-family:var(--font-body);font-weight:600;font-size:.7rem;letter-spacing:.04em;text-transform:uppercase;color:var(--blue-700);align-self:center}
.page-b2b .msg-row{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:4px}
.page-b2b .msg-btn{display:flex;align-items:center;justify-content:center;gap:9px;padding:11px 16px;border-radius:var(--r-pill);border:1px solid var(--line-strong);background:var(--surface);font-weight:600;font-size:.92rem;color:var(--navy-900);transition:.2s var(--ease)}
.page-b2b .msg-btn:hover{border-color:var(--blue);color:var(--blue-700)}
.page-b2b .msg-btn .ic{width:18px;height:18px;flex:none;-webkit-mask:var(--msg-icon) center/contain no-repeat;mask:var(--msg-icon) center/contain no-repeat}
.page-b2b .msg-btn .ic--tg{background-color:#229ED9}
.page-b2b .msg-btn .ic--viber{background-color:#7d3daf}
.page-b2b .addr{font-style:normal;color:var(--ink);font-size:.95rem;line-height:1.5}
.page-b2b .addr strong{display:block;font-family:var(--font-display);font-weight:700;font-size:1.02rem;color:var(--navy-900);margin-bottom:4px}
.page-b2b .contact-card .mail{font-family:var(--font-display);font-weight:700;color:var(--blue-700)}
.page-b2b .contact-card .mail:hover{text-decoration:underline}
.page-b2b .consult-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(24px,3vw,40px);align-items:start}
@media(max-width:860px){.page-b2b .consult-grid{grid-template-columns:1fr}}
@media(max-width:520px){.page-b2b .msg-row{grid-template-columns:1fr}.page-b2b .msg-btn{min-width:0}}
.page-b2b .consult-side .msg-btn{background:var(--navy-800);border-color:oklch(1 0 0 /.16);color:#fff}
.page-b2b .consult-side .msg-btn:hover{border-color:var(--blue)}
  </style>
  <section class="hero">
    <div class="hero-bg"><img src={page.hero.imagePath} loading="eager" alt={t(page.hero.imageAlt)}></div>
    <div class="container">
      <div class="hero-inner">
        <p class="breadcrumb"><a href="index.html">Головна</a> / {t(page.hero.label)}</p>
        <h1>{t(page.hero.title)}</h1>
        <p class="hero-sub">{t(page.hero.intro)}</p>
        <div class="hero-cta">
          <button class="btn btn--primary btn--lg" data-modal data-mode="consult">{t(page.hero.ctaLabel)}</button>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tint" id="contacts" aria-labelledby="contacts-h">
    <div class="container">
      <div class="section-head">
        <h2 id="contacts-h">{t(contacts.heading)}</h2>
        <p class="lead">{t(contacts.lead)}</p>
      </div>

      <div class="grid grid-3" style="gap:24px;align-items:start">

        <div class="contact-card">
          <h3>{t(support.title)}</h3>
          <p class="sub">{t(support.body)}</p>
          <ul class="phone-list">
            <li><a href={settings.supportPhoneHref}><svg class="ico" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8c1.4 2.8 3.7 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.4.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.4c.6 0 1 .4 1 1 0 1.2.2 2.5.6 3.6.1.4 0 .7-.2 1l-2.2 2.2Z"/></svg>{settings.supportPhoneDisplay} <span class="tag">безкоштовно</span></a></li>
            {settings.supportPhones.map((phone: any) => <li><a href={phone.href}><svg class="ico" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8c1.4 2.8 3.7 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.4.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.4c.6 0 1 .4 1 1 0 1.2.2 2.5.6 3.6.1.4 0 .7-.2 1l-2.2 2.2Z"/></svg>{t(phone.label)}</a></li>)}
          </ul>
        </div>

        <div class="contact-card">
          <h3>{t(messengers.title)}</h3>
          <p class="sub">{t(messengers.body)}</p>
          <div class="msg-row">
            <a class="msg-btn" href={settings.telegramUrl} target="_blank" rel="noopener">
              <span class="ic ic--tg" style="--msg-icon:url('assets/telegram.svg')" aria-hidden="true"></span>Telegram
            </a>
            <a class="msg-btn" href={settings.viberUrl} target="_blank" rel="noopener">
              <span class="ic ic--viber" style="--msg-icon:url('assets/vb.svg')" aria-hidden="true"></span>Viber
            </a>
          </div>
          <p class="sub" style="margin:22px 0 0">{t(messengers.result)}</p>
          <p style="margin-top:14px"><a class="link-arrow" href="#consult">Замовити консультацію <span class="ar" aria-hidden="true">→</span></a></p>
        </div>

        <div class="contact-card">
          <h3>{t(accounting.title)}</h3>
          <p class="sub">{t(accounting.body)}</p>
          <address class="addr" style="margin-bottom:16px">
            <strong>{t(settings.accountingAddress)}</strong>
          </address>
          <ul class="phone-list">
            {settings.accountingPhones.map((phone: any) => <li><a href={phone.href}><svg class="ico" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8c1.4 2.8 3.7 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.4.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.4c.6 0 1 .4 1 1 0 1.2.2 2.5.6 3.6.1.4 0 .7-.2 1l-2.2 2.2Z"/></svg>{t(phone.label)}</a></li>)}
          </ul>
          <div class="msg-row" style="margin-top:14px">
            <a class="msg-btn" href={settings.accountingTelegramUrl} target="_blank" rel="noopener">
              <span class="ic ic--tg" style="--msg-icon:url('assets/telegram.svg')" aria-hidden="true"></span>@bukh_astra
            </a>
            <a class="msg-btn" href={settings.accountingViberUrl} target="_blank" rel="noopener">
              <span class="ic ic--viber" style="--msg-icon:url('assets/vb.svg')" aria-hidden="true"></span>Viber @bukh_astra
            </a>
          </div>
          <p class="sub" style="margin:18px 0 0">E-mail: <a class="mail" href={`mailto:${settings.email}`}>{settings.email}</a></p>
        </div>

      </div>
    </div>
  </section>

  <section class="section section--navy" id="consult" aria-labelledby="consult-h">
    <div class="container">
      <div class="consult-grid">
        <div>
          <h2 id="consult-h">{t(consult.heading)}</h2>
          <p class="lead">{t(consult.lead)}</p>

          <div class="consult-side">
            <h3 style="color:#fff;margin-top:26px">{t(consult.label)}</h3>
            <div class="msg-row" style="margin-top:14px">
              <a class="msg-btn" href={settings.telegramUrl} target="_blank" rel="noopener">
                <span class="ic ic--tg" style="--msg-icon:url('assets/telegram.svg')" aria-hidden="true"></span>Telegram
              </a>
              <a class="msg-btn" href={settings.viberUrl} target="_blank" rel="noopener">
                <span class="ic ic--viber" style="--msg-icon:url('assets/vb.svg')" aria-hidden="true"></span>Viber
              </a>
            </div>
            <p class="lead" style="margin-top:20px">Цілодобова підтримка: <a href={settings.supportPhoneHref} style="color:#fff;font-weight:600">{settings.supportPhoneDisplay}</a></p>
          </div>
        </div>

        <div class="lead-card">
          <form data-lead style="display:flex;flex-direction:column;gap:14px">
            <input type="hidden" name="mode" value="consult">
            <div class="field"><label for="contacts-lead-name">Ім'я / компанія</label><input id="contacts-lead-name" type="text" name="name" autocomplete="organization" placeholder="Ваше ім'я або назва компанії"></div>
            <div class="field"><label for="contacts-lead-phone">Номер телефону</label><input id="contacts-lead-phone" type="tel" data-phone name="phone" autocomplete="tel" inputmode="tel" placeholder="+38 (0__) ___-__-__" required aria-describedby="contacts-lead-phone-error"><span class="err" id="contacts-lead-phone-error" aria-live="polite"></span></div>
            <div class="field"><label for="contacts-lead-address">Адреса об'єкта</label><input id="contacts-lead-address" type="text" name="address" autocomplete="street-address" placeholder="Місто, вулиця, будинок"></div>
            <div class="field"><label for="contacts-lead-message">Опишіть деталі вашого звернення</label><textarea id="contacts-lead-message" name="message" rows="3" placeholder="Тип об'єкта, потрібні послуги, орієнтовний масштаб"></textarea></div>
            <input type="hidden" name="tariff">
            <button class="btn btn--primary btn--block" type="submit">Надіслати заявку</button>
            <p class="form-note">Натискаючи кнопку, ви погоджуєтесь з обробкою даних згідно з політикою конфіденційності.</p>
            <div data-success style="display:none">
              <h4 style="color:var(--navy-900)">Вашу заявку прийнято!</h4>
              <p class="muted" style="font-size:.92rem;margin-top:8px">Дякуємо! Наш менеджер зв'яжеться з вами найближчим часом.</p>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>

  <section class="section tight">
    <div class="container">
      <div class="cta-band">
        <h2>{t(page.cta.title)}</h2>
        <p class="lead">{t(page.cta.text)}</p>
        <div class="row">
          <button class="btn btn--primary btn--lg" data-modal data-mode="consult">{t(page.cta.label)}</button>
        </div>
      </div>
    </div>
  </section>
</Layout>
