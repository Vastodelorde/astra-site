---
import Layout from '../layouts/Layout.astro';
import ServiceIcon, { type ServiceIconName } from '../components/ServiceIcon.astro';
import { servicesPageFallback, serviceCatalogFallback } from '../data/siteContent';
import { getManagedPage, getServices } from '../lib/sanity';
import { getSection, localize, mergeContent } from '../lib/content';

export const prerender = false;
const [managedPage, managedServices] = await Promise.all([getManagedPage('services'), getServices()]);
const page = mergeContent(servicesPageFallback, managedPage);
const services = mergeContent(serviceCatalogFallback, managedServices);
const seo: any = page.seo;
const t = (value: any) => localize(value, 'uk');
const groups = ['isp', 'install', 'cloud'] as const;
---
<Layout
  leadSource={t(page.hero.label)}
  title={t(seo.title)}
  description={t(seo.description)}
  canonical={seo.canonicalUk}
  ogTitle={t(seo.ogTitle) || t(seo.title)}
  ogDescription={t(seo.ogDescription) || t(seo.description)}
>
  <section class="hero">
    <div class="hero-bg"><img src={page.hero.imagePath} loading="eager" alt={t(page.hero.imageAlt)}></div>
    <div class="container">
      <div class="hero-inner">
        <p class="breadcrumb"><a href="index.html">Головна</a> / {t(page.hero.label)}</p>
        <h1>{t(page.hero.title)}</h1>
        <p class="hero-sub">{t(page.hero.intro)}</p>
        <div class="hero-cta">
          <button class="btn btn--primary btn--lg" data-modal data-mode="consult">{t(page.hero.ctaLabel)}</button>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {groups.map((group) => {
        const section = getSection<any>(page, group);
        const heading = t(section.heading);
        return <div class="svc-group">
          <h3>{heading.replace(/ (ISP|INSTALL|CLOUD)$/, '')} <span class="mk">{heading.match(/(ISP|INSTALL|CLOUD)$/)?.[0]}</span></h3>
          <p class="svc-group-sub">{t(section.lead)}</p>
          <div class="svc-grid">
            {services.filter((service: any) => service.group === group).map((service: any) => <article class="svc">
              <div class="svc-head"><ServiceIcon name={service.icon as ServiceIconName} /><h4>{t(service.title)}</h4></div>
              <p>{t(service.body)}</p>
              <a class="link-arrow" href={service.hrefUk}>{t(service.label)} <span class="ar" aria-hidden="true">→</span></a>
            </article>)}
          </div>
        </div>;
      })}
    </div>
  </section>

  <section class="section tight">
    <div class="container">
      <div class="cta-band">
        <h2>{t(page.cta.title)}</h2>
        <p class="lead">{t(page.cta.text)}</p>
        <div class="row">
          <button class="btn btn--primary btn--lg" data-modal data-mode="consult">{t(page.cta.label)}</button>
        </div>
      </div>
    </div>
  </section>
</Layout>
