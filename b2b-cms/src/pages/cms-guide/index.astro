  </div>

  <script>
    const sections = [...document.querySelectorAll<HTMLElement>('[data-guide-section]')];
    const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-guide-link]')];
    const search = document.querySelector<HTMLInputElement>('[data-guide-search]');
    const status = document.querySelector<HTMLElement>('[data-guide-status]');
    const empty = document.querySelector<HTMLElement>('[data-guide-empty]');
    const progress = document.querySelector<HTMLSpanElement>('.guide-progress span');

    const normalize = (value: string) => value.toLocaleLowerCase('uk').trim();

    search?.addEventListener('input', () => {
      const query = normalize(search.value);
      let count = 0;
      sections.forEach((section) => {
        const visible = !query || normalize(section.textContent).includes(query);
        section.hidden = !visible;
        const link = document.querySelector(`[data-guide-link="${section.id}"]`)?.closest('li');
        if (link) link.hidden = !visible;
        if (visible) count += 1;
      });
      if (status) status.textContent = query ? `Знайдено розділів: ${count}` : '';
      if (empty) empty.hidden = count > 0;
    });

    const observer = new IntersectionObserver((entries) => {
      const visible = entries.filter((entry) => entry.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
      if (!visible) return;
      const target = visible.target as HTMLElement;
      links.forEach((link) => link.toggleAttribute('aria-current', link.dataset.guideLink === target.id));
    }, { rootMargin: '-18% 0px -68% 0px', threshold: [0, .25, .5] });
    sections.forEach((section) => observer.observe(section));

    const updateProgress = () => {
      const root = document.documentElement;
      const max = root.scrollHeight - root.clientHeight;
      if (progress) progress.style.transform = `scaleX(${max > 0 ? root.scrollTop / max : 0})`;
    };
    updateProgress();
    document.addEventListener('scroll', updateProgress, { passive: true });
  </script>
</Layout>
