---
import Layout from '../../layouts/Layout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getBlogPost, getBlogPosts } from '../../lib/sanity';
import { toHTML } from '@portabletext/to-html';
import { starterEnSourceSlug } from '../../data/blogEn';

export const prerender = false;
const post = await getBlogPost(Astro.params.slug || '');
if (!post) return new Response('Статтю не знайдено', { status: 404, headers: { 'Content-Type': 'text/plain; charset=utf-8' } });
const related = (await getBlogPosts()).filter((item) => item.slug !== post.slug).slice(0, 2);
const cover = post.image.startsWith('https://cdn.sanity.io/') ? `${post.image}?w=1600&auto=format&q=85` : post.image.startsWith('http') ? post.image : `../../${post.image}`;
const content = toHTML(post.body || []);
const translatedPost = (await getBlogPosts('en')).find((item) => item.sourceSlug === post.slug || item.slug === starterEnSourceSlug[post.slug]);
const alternatePath = translatedPost ? `/en/blog/${translatedPost.slug}/` : '/en/blog/';
---
<Layout alternatePath={alternatePath} title={`${post.title} | Блог АСТРА`} description={post.excerpt} canonical={`https://astra.in.ua/b2b/blog/${post.slug}/`} ogTitle={post.title} ogDescription={post.excerpt} ogImage={post.image.startsWith('http') ? post.image : `https://astra.in.ua/b2b/${post.image}`} pathPrefix="../../" bodyClass="page-b2b page-blog ctx-biz mode-biz">
  <article class="blog-article">
    <header class="blog-article__header">
      <div class="container">
        <nav class="blog-breadcrumb" aria-label="Навігаційний ланцюжок"><a href="../../index.html">Головна</a><span aria-hidden="true">/</span><a href="../">Блог</a></nav>
        <div class="blog-article__heading">
          <div class="blog-article__meta">{post.category}</div>
          <h1>{post.title}</h1>
          <p class="blog-article__intro">{post.excerpt}</p>
        </div>
        <figure class="blog-article__cover"><img src={cover} alt={post.imageAlt} width="1536" height="864" fetchpriority="high"></figure>
      </div>
    </header>
    <div class="blog-article__content">
      <div class="container blog-article__inner">
        <div class="blog-article__body" set:html={content} />
        <div class="blog-article__end"><a class="link-arrow" href="../">Усі статті <span class="ar" aria-hidden="true">→</span></a></div>
      </div>
    </div>
  </article>
  {related.length > 0 && <section class="section blog-related"><div class="container"><h2>Читайте також</h2><div class="blog-grid">{related.map((item) => <BlogCard post={item} pathPrefix="../../" />)}</div></div></section>}
</Layout>
