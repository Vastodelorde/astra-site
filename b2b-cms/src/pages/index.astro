---
import Layout from '../layouts/Layout.astro';
  import BlogCard from '../components/BlogCard.astro';
  import BusinessSizeIcon from '../components/BusinessSizeIcon.astro';
  import { homePageFallback } from '../data/siteContent';
  import { getBlogPosts, getManagedPage } from '../lib/sanity';
  import { getSection, localize, mergeContent } from '../lib/content';

  export const prerender = false;
  const [managedPage, posts] = await Promise.all([getManagedPage('home'), getBlogPosts()]);
  const page = mergeContent(homePageFallback, managedPage);
  const latestPosts = posts.slice(0, 3);
  const t = (value: any) => localize(value, 'uk');
  const segments = getSection<any>(page, 'segments-size');
  const directions = getSection<any>(page, 'directions');
  const pains = getSection<any>(page, 'pain');
  const objects = getSection<any>(page, 'objects');
  const collaboration = getSection<any>(page, 'chomu');
  const partners = getSection<any>(page, 'partners');
  const blog = getSection<any>(page, 'blog');
---
<Layout
  title={t(page.seo.title)}
  description={t(page.seo.description)}
  canonical={page.seo.canonicalUk}
  ogTitle={t(page.seo.ogTitle) || t(page.seo.title)}
  ogDescription={t(page.seo.ogDescription) || t(page.seo.description)}
>
  <section class="hero hero--home">
    <div class="hero-bg"><img src={page.hero.imagePath} loading="eager" alt={t(page.hero.imageAlt)}></div>
    <div class="container">
      <div class="hero-inner">
        <h1>{t(page.hero.title)}</h1>
        <p class="hero-sub">{t(page.hero.intro)}</p>
        <div class="hero-cta">
          <button class="btn btn--primary btn--lg" data-modal data-mode="consult">{t(page.hero.ctaLabel)}</button>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tint" id="segments-size">
    <div class="container">
      <div class="section-head">
        <h2>{t(segments.heading)}</h2>
        <p class="lead">{t(segments.lead)}</p>
      </div>
      <div class="size-grid">
        {segments.items?.map((item: any) => <article class="size-card">
          <div class="top">
            <BusinessSizeIcon name={item.icon} />
            <div><p class="who">{t(item.title)}</p><p class="rng">{t(item.subtitle)}</p></div>
          </div>
          <ul>{item.features?.map((feature: any) => <li>{t(feature)}</li>)}</ul>
          <a class="link-arrow" href={item.href}>{t(item.label) || (item.key === 'operators' ? 'Для операторів' : 'Детальніше')} <span class="ar" aria-hidden="true">→</span></a>
        </article>)}
      </div>
    </div>
  </section>

  <section class="section" id="directions">
    <div class="container">
      <div class="section-head">
        <h2>{t(directions.heading)}</h2>
        <p class="lead">{t(directions.lead)}</p>
      </div>
      <div class="grid grid-3">
        {directions.items?.map((item: any) => <article class="dir-card">
          <span class="badge">ASTRA <span class="mk">{t(item.title).replace('ASTRA ', '')}</span></span>
          <p>{t(item.body)}</p>
          <a class="link-arrow" href={item.href}>{t(item.label)} <span class="ar">→</span></a>
        </article>)}
      </div>
    </div>
  </section>

  <section class="section section--tint" id="pain">
    <div class="container home-pains">
      <div class="section-head">
        <h2>{t(pains.heading)}</h2>
        <p class="lead">{t(pains.lead)}</p>
      </div>
      <div class="home-pains__list">
        {pains.items?.map((item: any) => <article class="pain"><span class="from">{t(item.title)}</span><span class="to">{t(item.result)}</span></article>)}
      </div>
    </div>
  </section>

  <section class="section" id="objects">
    <div class="container">
      <div class="section-head">
        <h2>{t(objects.heading)}</h2>
        <p class="lead">{t(objects.lead)}</p>
      </div>
      <div class="grid grid-3">
        {objects.items?.map((item: any) => <article class="seg-card" style={`background-image:linear-gradient(180deg,transparent 30%,oklch(0.18 0.04 264 /.9)),url('${item.imagePath}')`}><div><h4>{t(item.title)}</h4><p>{t(item.body)}</p></div></article>)}
      </div>
    </div>
  </section>

  <section class="section section--navy" id="chomu">
    <div class="container">
      <div class="section-head">
        <h2>{t(collaboration.heading)}</h2>
        <p class="lead">{t(collaboration.lead)}</p>
      </div>
      <div class="home-collab">
        {collaboration.items?.map((item: any) => <article class="diff"><h4>{t(item.title)}</h4><p>{t(item.body)}</p></article>)}
      </div>
    </div>
  </section>

  <section class="section section--tint" id="partners">
    <div class="container">
      <div class="ref-grid home-trust-panel">
        <div class="ref-media"><img src={partners.imagePath} width="1536" height="1920" loading="lazy" alt={t(partners.imageAlt)}></div>
        <div class="home-trust-panel__copy">
          <h2>{t(partners.heading)}</h2>
          <p class="lead">{t(partners.lead)}</p>
          <p style="margin-top:14px;color:var(--muted);font-size:.94rem">{t(partners.note)}</p>
        </div>
      </div>
      <div class="partners partners--home" style="margin-top:clamp(36px,5vw,56px)">
        <span class="partner"><img src="img/partners/1.jpg" alt="Клієнт АСТРА" loading="lazy"></span>
        <span class="partner"><img src="img/partners/2.jpg" alt="Клієнт АСТРА" loading="lazy"></span>
        <span class="partner"><img src="img/partners/3.jpg" alt="Клієнт АСТРА" loading="lazy"></span>
        <span class="partner"><img src="img/partners/4.jpg" alt="Клієнт АСТРА" loading="lazy"></span>
        <span class="partner"><img src="img/partners/5.jpg" alt="Клієнт АСТРА" loading="lazy"></span>
        <span class="partner"><img src="img/partners/6.jpg" alt="Клієнт АСТРА" loading="lazy"></span>
        <span class="partner"><img src="img/partners/7.jpg" alt="Клієнт АСТРА" loading="lazy"></span>
        <span class="partner"><img src="img/partners/8.jpg" alt="Клієнт АСТРА" loading="lazy"></span>
        <span class="partner"><img src="img/partners/9.jpg" alt="Клієнт АСТРА" loading="lazy"></span>
        <span class="partner"><img src="img/partners/10.jpg" alt="Клієнт АСТРА" loading="lazy"></span>
        <span class="partner"><img src="img/partners/11.jpg" alt="Клієнт АСТРА" loading="lazy"></span>
        <span class="partner"><img src="img/partners/12.jpg" alt="Клієнт АСТРА" loading="lazy"></span>
        <span class="partner"><img src="img/partners/13.jpg" alt="Клієнт АСТРА" loading="lazy"></span>
        <span class="partner"><img src="img/partners/14.jpg" alt="Клієнт АСТРА" loading="lazy"></span>
        <span class="partner"><img src="img/partners/15.jpg" alt="Клієнт АСТРА" loading="lazy"></span>
        <span class="partner"><img src="img/partners/16.jpg" alt="Клієнт АСТРА" loading="lazy"></span>
        <span class="partner partner--ugcc"><img src="img/partners/17.jpg" alt="Українська Греко-Католицька Церква" loading="lazy"></span>
      </div>
    </div>
  </section>

  {latestPosts.length > 0 && <section class="section section--navy blog-feature" id="blog">
    <div class="container">
      <div class="blog-feature__head"><h2>{t(blog.heading)}</h2><a class="blog-all" href={blog.href}>{t(blog.label)} <span aria-hidden="true">→</span></a></div>
      <div class="blog-grid">{latestPosts.map((post) => <BlogCard post={post} />)}</div>
    </div>
  </section>}

  <section class="section tight">
    <div class="container">
      <div class="cta-band">
        <h2>{t(page.cta.title)}</h2>
        <p class="lead">{t(page.cta.text)}</p>
        <div class="row">
          <button class="btn btn--primary btn--lg" data-modal data-mode="consult">{t(page.cta.label)}</button>
        </div>
      </div>
    </div>
  </section>
</Layout>
