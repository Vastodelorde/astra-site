---
import Layout from '../layouts/Layout.astro';
import { pricingPageFallback, tariffCatalogFallback } from '../data/siteContent';
import { getManagedPage, getTariffs } from '../lib/sanity';
import { getSection, localize, mergeContent } from '../lib/content';

export const prerender = false;
const [managedPage, managedTariffs] = await Promise.all([getManagedPage('pricing'), getTariffs()]);
const page = mergeContent(pricingPageFallback, managedPage);
const tariffs = mergeContent(tariffCatalogFallback, managedTariffs);
const seo: any = page.seo;
const plans = getSection<any>(page, 'plans');
const operators = getSection<any>(page, 'operatory');
const t = (value: any) => localize(value, 'uk');
---
<Layout
  leadSource={t(page.hero.label)}
  title={t(seo.title)}
  description={t(seo.description)}
  canonical={seo.canonicalUk}
  ogTitle={t(seo.ogTitle) || t(seo.title)}
  ogDescription={t(seo.ogDescription) || t(seo.description)}
>
  <style is:global slot="head">
.page-b2b .tariff-note{margin-top:clamp(20px,3vw,32px);font-size:.94rem;color:var(--muted);line-height:1.6}
.page-b2b .op-note{margin-top:clamp(20px,3vw,28px);font-size:.94rem;color:var(--muted);line-height:1.6}
  </style>
  <section class="hero">
    <div class="hero-bg"><img src={page.hero.imagePath} loading="eager" alt={t(page.hero.imageAlt)}></div>
    <div class="container">
      <div class="hero-inner">
        <p class="breadcrumb"><a href="index.html">Головна</a> / {t(page.hero.label)}</p>
        <h1>{t(page.hero.title)}</h1>
        <p class="hero-sub">{t(page.hero.intro)}</p>
        <div class="hero-cta"><button class="btn btn--primary btn--lg" data-modal data-mode="consult">{t(page.hero.ctaLabel)}</button></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head"><h2>{t(plans.heading)}</h2><p class="lead">{t(plans.lead)}</p></div>
      <div class="tariff-list">
        {tariffs.map((tariff: any) => <article class="trow">
          <div class="sp">
            <span class="plan">{tariff.plan}</span>
            <span class="val">{tariff.speed}<small>{tariff.unit}</small></span>
            {tariff.guar && <span class="guar">{tariff.guar}</span>}
          </div>
          <ul class="svc-list">{tariff.features?.map((feature: string) => <li>{feature}</li>)}</ul>
          <div class="buy">
            <span class="price">{tariff.price} <span class="per">{tariff.per}</span></span>
            <button class="btn btn--primary" data-modal data-mode="callback" data-tariff={tariff.tag || tariff.plan}>Замовити консультацію</button>
          </div>
        </article>)}
      </div>
      <p class="tariff-note">{t(plans.note)}</p>
    </div>
  </section>

  <section class="section section--tint" id="operatory">
    <div class="container">
      <div class="section-head"><h2>{t(operators.heading)}</h2><p class="lead">{t(operators.lead)}</p></div>
      <div class="grid grid-3">
        {operators.items?.map((item: any) => <article class="card">
          <h4>{t(item.title)}</h4><p>{t(item.body)}</p>
          <a class="link-arrow" href={item.href}>{t(item.label)} <span class="ar" aria-hidden="true">→</span></a>
        </article>)}
      </div>
      <p class="op-note">{t(operators.note)} <a class="link-arrow" href={operators.href}>{t(operators.label)} <span class="ar" aria-hidden="true">→</span></a></p>
    </div>
  </section>

  <section class="section tight">
    <div class="container">
      <div class="cta-band">
        <h2>{t(page.cta.title)}</h2><p class="lead">{t(page.cta.text)}</p>
        <div class="row"><button class="btn btn--primary btn--lg" data-modal data-mode="consult">{t(page.cta.label)}</button></div>
      </div>
    </div>
  </section>
</Layout>
