---
import Layout from '../../../layouts/Layout.astro';
import BlogCard from '../../../components/BlogCard.astro';
import { getBlogPosts } from '../../../lib/sanity';
import { starterEnSourceSlug } from '../../../data/blogEn';
import { toHTML } from '@portabletext/to-html';

export const prerender = false;
const [posts, sourcePosts] = await Promise.all([getBlogPosts('en'), getBlogPosts()]);
const post = posts.find((item) => item.slug === (Astro.params.slug || ''));
if (!post) return new Response('Article not found', { status: 404, headers: { 'Content-Type': 'text/plain; charset=utf-8' } });
const related = posts.filter((item) => item.slug !== post.slug).slice(0, 2);
const cover = post.image.startsWith('https://cdn.sanity.io/') ? `${post.image}?w=1600&auto=format&q=85` : post.image.startsWith('http') ? post.image : `../../../${post.image}`;
const content = toHTML(post.body || []);
const sourceSlug = post.sourceSlug || Object.keys(starterEnSourceSlug).find((key) => starterEnSourceSlug[key] === post.slug && sourcePosts.some((item) => item.slug === key));
const alternatePath = sourceSlug || post.sourceSlug ? `/blog/${sourceSlug || post.sourceSlug}/` : '/blog/';
---
<Layout locale="en" alternatePath={alternatePath} title={`${post.title} | ASTRA Blog`} description={post.excerpt} canonical={`https://astra.in.ua/b2b/en/blog/${post.slug}/`} ogTitle={post.title} ogDescription={post.excerpt} ogImage={post.image.startsWith('http') ? post.image : `https://astra.in.ua/b2b/${post.image}`} pathPrefix="../../../" bodyClass="page-b2b page-blog ctx-biz mode-biz">
  <article class="blog-article">
    <header class="blog-article__header"><div class="container">
      <nav class="blog-breadcrumb" aria-label="Breadcrumb"><a href="../../">Home</a><span aria-hidden="true">/</span><a href="../">Blog</a></nav>
      <div class="blog-article__heading"><div class="blog-article__meta">{post.category}</div><h1>{post.title}</h1><p class="blog-article__intro">{post.excerpt}</p></div>
      <figure class="blog-article__cover"><img src={cover} alt={post.imageAlt} width="1536" height="864" fetchpriority="high"></figure>
    </div></header>
    <div class="blog-article__content"><div class="container blog-article__inner">
      <div class="blog-article__body" set:html={content} />
      <div class="blog-article__end"><a class="link-arrow" href="../">All articles <span class="ar" aria-hidden="true">→</span></a></div>
    </div></div>
  </article>
  {related.length > 0 && <section class="section blog-related"><div class="container"><h2>Read next</h2><div class="blog-grid">{related.map((item) => <BlogCard post={item} pathPrefix="../../../" sitePrefix="../../../en/" />)}</div></div></section>}
</Layout>
