---
const { locale = 'uk' } = Astro.props;
const en = locale === 'en';
---
<div class="modal" id="lead-modal" role="dialog" aria-modal="true" aria-hidden="true" aria-labelledby="lead-modal-title" inert>
  <div class="backdrop" data-close></div>
  <div class="panel">
    <button class="x" data-close aria-label={en ? 'Close' : 'Закрити'}>✕</button>
    <div data-modal-form-content>
      <h3 id="lead-modal-title" style="margin:8px 0 4px">{en ? 'Request a consultation' : 'Замовити консультацію'}</h3>
      <p class="modal-context" data-context-line hidden><span data-context-label></span> <b></b></p>
      <p class="muted" style="font-size:.9rem;margin-bottom:18px">{en ? 'Our manager will contact you, recommend a solution, and prepare a proposal.' : "Наш менеджер зв'яжеться з вами, підбере рішення та підготує пропозицію."}</p>
      <form data-lead style="display:flex;flex-direction:column;gap:14px">
        <div class="field"><label for="lead-modal-name">{en ? 'Name / company' : "Ім'я / компанія"}</label><input id="lead-modal-name" type="text" name="name" autocomplete="organization" placeholder={en ? 'Your name or company' : "Ваше ім'я або назва компанії"}></div>
        <div class="field"><label for="lead-modal-phone">{en ? 'Phone number' : 'Номер телефону'}</label><input id="lead-modal-phone" type="tel" data-phone name="phone" autocomplete="tel" inputmode="tel" placeholder="+38 (0__) ___-__-__" required aria-describedby="lead-modal-phone-error"><span class="err" id="lead-modal-phone-error" aria-live="polite"></span></div>
        <div class="field"><label for="lead-modal-address">{en ? 'Site address' : "Адреса об'єкта"}</label><input id="lead-modal-address" type="text" name="address" autocomplete="street-address" placeholder={en ? 'City, street, building' : 'Місто, вулиця, будинок'}></div>
        <div class="field"><label for="lead-modal-message">{en ? 'Tell us what you need' : 'Опишіть деталі вашого звернення'}</label><textarea id="lead-modal-message" name="message" rows="3" placeholder={en ? 'Site type, services needed, approximate scale' : "Тип об'єкта, потрібні послуги, орієнтовний масштаб"}></textarea></div>
        <input type="hidden" name="tariff">
        <input type="hidden" name="source">
        <button class="btn btn--primary btn--block" type="submit">{en ? 'Send request' : 'Надіслати заявку'}</button>
        <p class="form-note">{en ? 'By submitting this form, you agree to the processing of your data under our privacy policy.' : 'Натискаючи кнопку, ви погоджуєтесь з обробкою даних згідно з політикою конфіденційності.'}</p>
      </form>
    </div>
    <div class="modal-success" data-modal-success hidden role="status">
      <h3 id="lead-modal-success-title">{en ? 'Your request has been received!' : 'Вашу заявку прийнято!'}</h3>
      <p class="muted">{en ? 'Thank you! Our manager will contact you shortly.' : "Дякуємо! Наш менеджер зв'яжеться з вами найближчим часом."}</p>
      <button class="btn btn--primary btn--block" type="button" data-close>{en ? 'OK' : 'Ок'}</button>
    </div>
  </div>
</div>
