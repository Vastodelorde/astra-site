---
// Canonical B2B header/nav. Active link is set client-side by astra.js (by filename).
const { pathPrefix = '' } = Astro.props;
---
<header class="site-header">
  <div class="container topbar">
    <a class="brand" href={`${pathPrefix}index.html`} aria-label="АСТРА, на головну"><img class="brand-mark" src={`${pathPrefix}assets/logo-mark.svg`} alt=""><span class="brand-word">АСТРА</span></a>
    <span class="t-msgs">
      <a class="t-msg" href="https://t.me/astraispbot" target="_blank" rel="noopener" aria-label="Telegram"><img src={`${pathPrefix}assets/telegram.svg`} alt=""></a>
      <a class="t-msg" href="viber://chat?number=%2B380800203838" target="_blank" rel="noopener" aria-label="Viber"><img src={`${pathPrefix}assets/vb.svg`} alt=""></a>
    </span>
    <a class="t-phone" href="tel:+380800203838">0&nbsp;800&nbsp;20-38-38<small>цілодобова підтримка</small></a>
    <button class="btn btn--primary btn--sm" data-modal data-mode="consult">Замовити консультацію</button>
    <button class="burger" aria-label="Меню" aria-expanded="false"><span></span></button>
  </div>
  <nav class="mainnav" aria-label="Головна навігація">
    <div class="container">
      <ul>
        <li><a class="navlink" href={`${pathPrefix}index.html`}>Астра B2B</a></li>
        <li><a class="navlink" href={`${pathPrefix}maliy.html`}>Малий бізнес</a></li>
        <li><a class="navlink" href={`${pathPrefix}seredniy.html`}>Середній бізнес</a></li>
        <li><a class="navlink" href={`${pathPrefix}velykyi.html`}>Великий бізнес</a></li>
        <li><a class="navlink" href={`${pathPrefix}operators.html`}>Оператори</a></li>
        <li>
          <a class="navlink" href={`${pathPrefix}isp.html`}>Напрямки <i class="chev"></i></a>
          <div class="mega cols-4">
            <div class="col"><b>ASTRA ISP</b>
              <a href={`${pathPrefix}isp.html#xgspon`}>XGS-PON до <span style="white-space:nowrap">10 Гбіт/с</span></a>
              <a href={`${pathPrefix}isp.html#stability`}>Резервні магістралі</a>
              <a href={`${pathPrefix}isp.html#europe`}>Прямі канали в Європу</a>
            </div>
            <div class="col"><b>ASTRA INSTALL</b>
              <a href={`${pathPrefix}install.html#videonagliad`}>Відеонагляд + аналітика</a>
              <a href={`${pathPrefix}install.html#access`}>СКУД, домофонія, шлагбауми</a>
              <a href={`${pathPrefix}install.html#networks`}>СКС, Wi-Fi, ВОЛЗ</a>
              <a href={`${pathPrefix}install.html#multimedia`}>Мультимедіа, конференц-системи</a>
            </div>
            <div class="col"><b>ASTRA CLOUD</b>
              <a href={`${pathPrefix}cloud.html#kolokatsiia`}>Колокація</a>
              <a href={`${pathPrefix}cloud.html#vps`}>VPS / VDS</a>
              <a href={`${pathPrefix}cloud.html#server`}>Оренда серверів</a>
            </div>
            <div class="col"><b>Каталог</b>
              <a href={`${pathPrefix}poslugy.html`}>Усі послуги</a>
              <a href={`${pathPrefix}taryfy.html`}>Усі тарифи</a>
              <a href={`${pathPrefix}operators.html`}>Для операторів</a>
            </div>
          </div>
        </li>
        <li><a class="navlink" href={`${pathPrefix}blog/`}>Блог</a></li>
        <li><a class="navlink" href={`${pathPrefix}pro.html`}>Про нас</a></li>
        <li><a class="navlink" href={`${pathPrefix}kontakty.html`}>Контакти</a></li>
      </ul>
    </div>
  </nav>
</header>
