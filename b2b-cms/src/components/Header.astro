---
const { pathPrefix = '', sitePrefix = pathPrefix, locale = 'uk', alternateHref = '#' } = Astro.props;
const en = locale === 'en';
const link = (page: string) => `${sitePrefix}${page}`;
---
<header class="site-header">
  <div class="container topbar">
    <a class="brand" href={link(en ? '' : 'index.html')} aria-label={en ? 'ASTRA, home' : 'АСТРА, на головну'}><img class="brand-mark" src={`${pathPrefix}assets/logo-mark.svg`} alt=""><span class="brand-word">{en ? 'ASTRA' : 'АСТРА'}</span></a>
    <span class="t-msgs">
      <a class="t-msg" href="https://t.me/astraispbot" target="_blank" rel="noopener" aria-label="Telegram"><img src={`${pathPrefix}assets/telegram.svg`} alt=""></a>
      <a class="t-msg" href="viber://chat?number=%2B380800203838" target="_blank" rel="noopener" aria-label="Viber"><img src={`${pathPrefix}assets/vb.svg`} alt=""></a>
    </span>
    <a class="t-phone" href="tel:+380800203838">0&nbsp;800&nbsp;20-38-38<small>{en ? '24/7 support' : 'цілодобова підтримка'}</small></a>
    <a class="lang-switch lang-switch--top" href={alternateHref} lang={en ? 'uk' : 'en'} aria-label={en ? 'Українська версія' : 'English version'}>{en ? 'УКР' : 'EN'}</a>
    <button class="btn btn--primary btn--sm" data-modal data-mode="consult">{en ? 'Request a consultation' : 'Замовити консультацію'}</button>
    <button class="burger" aria-label={en ? 'Open menu' : 'Відкрити меню'} data-label-open={en ? 'Open menu' : 'Відкрити меню'} data-label-close={en ? 'Close menu' : 'Закрити меню'} aria-expanded="false" aria-controls="mobile-menu"><span></span></button>
  </div>
  <nav class="mainnav" aria-label={en ? 'Main navigation' : 'Головна навігація'}>
    <div class="container"><ul>
      <li><a class="navlink" href={link(en ? '' : 'index.html')}>ASTRA B2B</a></li>
      <li><a class="navlink" href={link('maliy.html')}>{en ? 'Small business' : 'Малий бізнес'}</a></li>
      <li><a class="navlink" href={link('seredniy.html')}>{en ? 'Medium business' : 'Середній бізнес'}</a></li>
      <li><a class="navlink" href={link('velykyi.html')}>{en ? 'Large business' : 'Великий бізнес'}</a></li>
      <li><a class="navlink" href={link('operators.html')}>{en ? 'Operators' : 'Оператори'}</a></li>
      <li><a class="navlink" href={link('isp.html')}>{en ? 'Solutions' : 'Напрямки'} <i class="chev"></i></a>
        <div class="mega cols-4">
          <div class="col"><b>ASTRA ISP</b>
            <a href={link('isp.html#xgspon')}>{en ? 'XGS-PON up to 10 Gbps' : 'XGS-PON до 10 Гбіт/с'}</a>
            <a href={link('isp.html#stability')}>{en ? 'Redundant backbone' : 'Резервні магістралі'}</a>
            <a href={link('isp.html#europe')}>{en ? 'Direct routes to Europe' : 'Прямі канали в Європу'}</a>
          </div>
          <div class="col"><b>ASTRA INSTALL</b>
            <a href={link('install.html#videonagliad')}>{en ? 'Video surveillance & analytics' : 'Відеонагляд + аналітика'}</a>
            <a href={link('install.html#access')}>{en ? 'Access control & intercoms' : 'СКУД, домофонія, шлагбауми'}</a>
            <a href={link('install.html#networks')}>{en ? 'Structured cabling, Wi-Fi, fiber' : 'СКС, Wi-Fi, ВОЛЗ'}</a>
            <a href={link('install.html#multimedia')}>{en ? 'Multimedia & conferencing' : 'Мультимедіа, конференц-системи'}</a>
          </div>
          <div class="col"><b>ASTRA CLOUD</b>
            <a href={link('cloud.html#kolokatsiia')}>{en ? 'Colocation' : 'Колокація'}</a>
            <a href={link('cloud.html#vps')}>VPS / VDS</a>
            <a href={link('cloud.html#server')}>{en ? 'Dedicated servers' : 'Оренда серверів'}</a>
          </div>
          <div class="col"><b>{en ? 'Explore' : 'Каталог'}</b>
            <a href={link('poslugy.html')}>{en ? 'All services' : 'Усі послуги'}</a>
            <a href={link('taryfy.html')}>{en ? 'All plans' : 'Усі тарифи'}</a>
            <a href={link('operators.html')}>{en ? 'For operators' : 'Для операторів'}</a>
          </div>
        </div>
      </li>
      <li><a class="navlink" href={link('blog/')}>{en ? 'Blog' : 'Блог'}</a></li>
      <li><a class="navlink" href={link('pro.html')}>{en ? 'About us' : 'Про нас'}</a></li>
      <li><a class="navlink" href={link('kontakty.html')}>{en ? 'Contacts' : 'Контакти'}</a></li>
    </ul></div>
  </nav>
</header>
