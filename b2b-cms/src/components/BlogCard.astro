---
import type { BlogPost } from '../data/blog';
const { post, pathPrefix = '', sitePrefix = pathPrefix } = Astro.props as { post: BlogPost; pathPrefix?: string; sitePrefix?: string };
const image = post.image.startsWith('https://cdn.sanity.io/') ? `${post.image}?w=900&auto=format&q=82` : `${pathPrefix}${post.image}`;
---
<article class="blog-card">
  <a class="blog-card__media" href={`${sitePrefix}blog/${post.slug}/`} aria-label={post.title}>
    <img src={image} alt={post.imageAlt} loading="lazy" width="1536" height="864">
  </a>
  <div class="blog-card__meta">{post.category}</div>
  <h3><a href={`${sitePrefix}blog/${post.slug}/`}>{post.title}</a></h3>
  <p>{post.excerpt}</p>
</article>
