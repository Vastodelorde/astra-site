---
import Layout from '../layouts/Layout.astro';
import BlogCard from './BlogCard.astro';
import { getBlogPosts } from '../lib/sanity';
import type { EnglishPage } from '../data/enPages';

const { page, slug } = Astro.props as { page: EnglishPage; slug: string };
const latestPosts = slug === 'index' ? (await getBlogPosts('en')).slice(0, 3) : [];
const canonical = `https://astra.in.ua/b2b/en/${slug === 'index' ? '' : `${slug}.html`}`;
const partnerImages = Array.from({ length: 17 }, (_, index) => index + 1);
const brandImages = ['dahua', 'hikvision', 'u-prox', 'zkteco', 'bft', 'nice', 'came', 'faac'];
---
<Layout locale="en" title={page.title} description={page.description} canonical={canonical} leadSource={page.source} pathPrefix="../" bodyClass="page-b2b page-en ctx-biz mode-biz">
  <section class:list={['hero', { 'hero--home': slug === 'index' }]}>
    <div class="hero-bg"><img src={`../${page.hero.image}`} loading="eager" alt={page.hero.title}></div>
    <div class="container"><div class="hero-inner">
      {slug !== 'index' && <p class="breadcrumb"><a href="./">Home</a> / {page.hero.label}</p>}
      <h1>{page.hero.title}</h1>
      <p class="hero-sub">{page.hero.intro}</p>
      <div class="hero-cta"><button class="btn btn--primary btn--lg" data-modal data-mode="consult">Request a consultation</button></div>
    </div></div>
  </section>

  {page.sections.map((section) => <section class:list={['section', { 'section--tint': section.tone === 'tint', 'section--navy': section.tone === 'navy', 'blog-feature': section.kind === 'blog' }]} id={section.id}>
    <div class="container">
      <div class="section-head"><h2>{section.heading}</h2>{section.lead && <p class="lead">{section.lead}</p>}</div>

      {section.kind === 'cards' && <div class="grid grid-3">{section.items?.map((item) => <article class="card" id={item.id}>
        <h3>{item.title}</h3><p>{item.body}</p>
        {item.href && <a class="link-arrow" href={item.href}>{item.href.startsWith('tel:') ? 'Call us' : item.href.startsWith('mailto:') ? 'Send an email' : item.href.startsWith('https://t.me/') ? 'Open Telegram' : 'Explore'} <span class="ar" aria-hidden="true">→</span></a>}
        {item.links && <div class="en-contact-links">{item.links.map((link) => <a href={link.href}>{link.label}</a>)}</div>}
      </article>)}</div>}

      {section.kind === 'plans' && <><div class="tariff-list">{section.items?.map((item) => <article class="trow">
        <div class="sp"><span class="plan">{item.title}</span><span class="val">{item.body.split(' ')[0]}<small>Mbps</small></span>{item.body.split(' · ')[2] && <span class="guar">{item.body.split(' · ')[2]}</span>}</div>
        <ul class="svc-list">{item.features?.map((feature) => <li>{feature}</li>)}</ul>
        <div class="buy"><span class="price">{item.body.split(' · ')[1]}</span><button class="btn btn--primary" data-modal data-mode="callback" data-tariff={item.title}>Request a consultation</button></div>
      </article>)}</div>{section.footnote && <p class="tariff-note">{section.footnote}</p>}</>}

      {section.kind === 'people' && <div class="mgr-grid">{section.items?.map((item) => <figure class="mgr">
        <div class="mgr-photo"><img class="mgr-img" src={`../${item.image}`} alt={item.title} loading="lazy"></div>
        <figcaption class="mgr-cap"><b class="mgr-name">{item.title}</b><span class="mgr-role">{item.body}</span></figcaption>
      </figure>)}</div>}

      {section.kind === 'gallery' && <div class="grid grid-3">{section.items?.map((item) => <div class="ref-media">
        <img data-zoom src={`../${item.image}`} alt={item.title} loading="lazy">
      </div>)}</div>}

      {section.kind === 'stats' && <div class="trustbar tb-5">{section.items?.map((item) => <div class="ti"><div class="num">{item.title}</div><div class="lbl">{item.body}</div></div>)}</div>}

      {section.kind === 'partners' && <div class={section.id === 'brands' ? 'brand-logos' : 'partners partners--en'}>
        {(section.id === 'brands' ? brandImages : partnerImages).map((name) => <span class:list={['partner', { 'partner--ugcc': name === 17 }]}><img src={section.id === 'brands' ? `../img/brands/${name}.jpg` : `../img/partners/${name}.jpg`} alt={section.id === 'brands' ? String(name) : name === 17 ? 'Ukrainian Greek Catholic Church' : 'ASTRA client'} loading="lazy"></span>)}
      </div>}

      {section.kind === 'blog' && <><div class="blog-grid">{latestPosts.map((post) => <BlogCard post={post} pathPrefix="../" sitePrefix="../en/" />)}</div><p style="margin-top:28px"><a class="link-arrow" href="blog/">All articles <span class="ar" aria-hidden="true">→</span></a></p></>}

      {section.kind === 'contact' && <div class="lead-card" style="max-width:640px;margin-inline:auto"><form data-lead style="display:flex;flex-direction:column;gap:14px">
        <input type="hidden" name="mode" value="consult">
        <div class="field"><label>Name / company</label><input type="text" name="name" placeholder="Your name or company"></div>
        <div class="field"><label>Phone number</label><input type="tel" data-phone name="phone" placeholder="+38 (0__) ___-__-__" required><span class="err"></span></div>
        <div class="field"><label>Site address</label><input type="text" name="address" placeholder="City, street, building"></div>
        <div class="field"><label>Tell us what you need</label><textarea name="message" rows="3" placeholder="Site type, services needed, approximate scale"></textarea></div>
        <input type="hidden" name="tariff">
        <button class="btn btn--primary btn--block" type="submit">Send request</button>
        <p class="form-note">By submitting this form, you agree to the processing of your data under our privacy policy.</p>
        <div data-success style="display:none"><h4 style="color:var(--navy-900)">Request received!</h4><p class="muted" style="font-size:.92rem;margin-top:8px">Thank you! Our manager will contact you shortly. You can also reach us 24/7 on Telegram @astraispbot, Viber ASTRA, or 0 800 20-38-38.</p></div>
      </form></div>}
    </div>
  </section>)}

  <section class="section tight"><div class="container"><div class="cta-band">
    <h2>{page.cta.title}</h2><p class="lead">{page.cta.text}</p>
    <div class="row"><button class="btn btn--primary btn--lg" data-modal data-mode="consult">Request a consultation</button></div>
  </div></div></section>
</Layout>
