---
import Layout from '../layouts/Layout.astro';
import BlogCard from './BlogCard.astro';
import { getBlogPosts } from '../lib/sanity';
import type { EnglishPage } from '../data/enPages';

const { page, slug } = Astro.props as { page: EnglishPage; slug: string };
const latestPosts = slug === 'index' ? (await getBlogPosts('en')).slice(0, 3) : [];
const canonical = `https://astra.in.ua/b2b/en/${slug === 'index' ? '' : `${slug}.html`}`;
const partnerImages = Array.from({ length: 17 }, (_, index) => index + 1);
const brandImages = ['dahua', 'hikvision', 'u-prox', 'zkteco', 'bft', 'nice', 'came', 'faac'];
const segmentPages = new Set(['maliy', 'seredniy', 'velykyi']);
const sizeIcons = [
  '<path d="m2 7 4.4-4.4A2 2 0 0 1 7.8 2h8.4a2 2 0 0 1 1.4.6L22 7"/><path d="M4 7v13a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1V7"/><path d="M2 7h20"/><path d="M9 21v-6a2 2 0 0 1 4 0v6"/>',
  '<path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"/><path d="M10 6h4M10 10h4M10 14h4"/>',
  '<path d="M3 22h18M6 18v-7M10 18v-7M14 18v-7M18 18v-7"/><path d="m12 2 8 5H4Z"/>',
  '<rect x="9" y="2" width="6" height="6" rx="1"/><rect x="2" y="16" width="6" height="6" rx="1"/><rect x="16" y="16" width="6" height="6" rx="1"/><path d="M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3M12 12V8"/>',
];
const featureImages: Record<string, string> = {
  'install:videonagliad': 'img/sub-videonagliad.jpg',
  'install:access': 'img/sub-skud.jpg',
  'install:networks': 'img/sub-sks.jpg',
  'install:multimedia': 'img/sub-noc.jpg',
  'operators:volz': 'img/sub-volz.jpg',
  'operators:colocation': 'img/sub-kolokatsiia.jpg',
  'cloud:datacenter': 'img/sub-kolokatsiia.jpg',
};
---
<Layout locale="en" title={page.title} description={page.description} canonical={canonical} leadSource={page.source} pathPrefix="../" bodyClass={`page-b2b page-en page-en-${slug} ctx-biz mode-biz`}>
  <section class:list={['hero', { 'hero--home': slug === 'index' }]}>
    <div class="hero-bg"><img src={`../${page.hero.image}`} loading="eager" alt={page.hero.title}></div>
    <div class="container"><div class="hero-inner">
      {slug !== 'index' && <p class="breadcrumb"><a href={page.hero.parentHref ?? './'}>{page.hero.parentLabel ?? 'Home'}</a> / {page.hero.label}</p>}
      <h1>{page.hero.title}</h1>
      <p class="hero-sub">{page.hero.intro}</p>
      <div class="hero-cta"><button class="btn btn--primary btn--lg" data-modal data-mode="consult">Request a consultation</button></div>
    </div></div>
  </section>

  {slug === 'poslugy' && <section class="section"><div class="container">
    {page.sections.map((section) => <div class="svc-group">
      <h3>ASTRA <span class="mk">{section.heading.replace('ASTRA ', '')}</span></h3>
      {section.lead && <p class="svc-group-sub">{section.lead}</p>}
      <div class="svc-grid">{section.items?.map((item) => <article class="svc"><h4>{item.title}</h4><p>{item.body}</p>{item.href && <a class="link-arrow" href={item.href}>Explore <span class="ar" aria-hidden="true">→</span></a>}</article>)}</div>
    </div>)}
  </div></section>}

  {page.sections.filter(() => slug !== 'poslugy').map((section) => {
    const isInstallFeature = slug === 'install' && Boolean(section.id && featureImages[`install:${section.id}`]);
    const isOperatorFeature = slug === 'operators' && (section.id === 'volz' || section.id === 'colocation');
    const isCloudReference = slug === 'cloud' && section.id === 'datacenter';
    const isIndexPartners = slug === 'index' && section.kind === 'partners';
    const isContactConsult = slug === 'kontakty' && section.kind === 'contact';
    const isBlog = section.kind === 'blog';
    const embedsHeading = isInstallFeature || isOperatorFeature || isCloudReference || isIndexPartners || isContactConsult || isBlog || section.kind === 'stats';
    const gridClass = (section.items?.length ?? 0) === 2 ? 'grid grid-2' : 'grid grid-3';
    return <section class:list={[
      'section',
      { 'section--tint': section.tone === 'tint' && slug !== 'poslugy' },
      { 'section--navy': section.tone === 'navy' },
      { 'blog-feature': isBlog },
      { 'en-services-band': slug === 'poslugy' },
    ]} id={section.id}>
      <div class="container">
        {!embedsHeading && <div class="section-head"><h2>{section.heading}</h2>{section.lead && <p class="lead">{section.lead}</p>}</div>}

        {section.kind === 'copy' && <div class="en-copy-block">{section.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}</div>}

        {section.kind === 'cards' && slug === 'index' && section.id === 'segments-size' && <div class="size-grid">{section.items?.map((item, index) => <article class="size-card">
          <div class="top"><span class="ic"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={sizeIcons[index]}></svg></span><div><p class="who">{item.title}</p><p class="rng">{item.body}</p></div></div>
          <ul>{item.features?.map((feature) => <li>{feature}</li>)}</ul>
          <a class="link-arrow" href={item.href}>Explore <span class="ar" aria-hidden="true">→</span></a>
        </article>)}</div>}

        {section.kind === 'cards' && section.id === 'directions' && <div class="grid grid-3">{section.items?.map((item) => <article class="dir-card">
          <span class="badge">ASTRA <span class="mk">{item.title.replace('ASTRA ', '')}</span></span><p>{item.body}</p>
          {item.href && <a class="link-arrow" href={item.href}>Explore <span class="ar" aria-hidden="true">→</span></a>}
        </article>)}</div>}

        {section.kind === 'cards' && slug === 'index' && section.id === 'pain' && <div class="grid grid-3">{section.items?.map((item) => <article class="pain"><span class="from">{item.title}</span><span class="to">{item.body}</span></article>)}</div>}

        {section.kind === 'cards' && slug === 'index' && section.id === 'objects' && <div class="grid grid-3">{section.items?.map((item) => <article class="seg-card" style={`background-image:linear-gradient(180deg,transparent 30%,oklch(0.18 0.04 264 /.9)),url('../${item.image}')`}><div><h4>{item.title}</h4><p>{item.body}</p></div></article>)}</div>}

        {section.kind === 'cards' && section.id === 'chomu' && <div class="grid grid-3">{section.items?.map((item) => <article class="diff"><h4>{item.title}</h4><p>{item.body}</p></article>)}</div>}

        {section.kind === 'cards' && segmentPages.has(slug) && section.id === 'details' && <div class={(section.items?.length ?? 0) >= 3 ? 'grid grid-3' : 'grid grid-2'}>{section.items?.map((item) => <article class="diff"><h4>{item.title}</h4><p>{item.body}</p></article>)}</div>}

        {section.kind === 'cards' && ((segmentPages.has(slug) && section.id === 'services') || slug === 'poslugy' || (slug === 'taryfy' && section.id === 'operatory')) && <div class:list={['svc-group', { 'svc-group--standalone': slug !== 'poslugy' }]}>
          {slug === 'poslugy' && <><h3>{section.heading}</h3>{section.lead && <p class="svc-group-sub">{section.lead}</p>}</>}
          <div class="svc-grid">{section.items?.map((item) => <article class:list={['svc', { all: item.title === 'All services' }]}><h4>{item.title}</h4><p>{item.body}</p>{item.href && <a class="link-arrow" href={item.href}>Explore <span class="ar" aria-hidden="true">→</span></a>}</article>)}</div>
        </div>}

        {section.kind === 'cards' && ((slug === 'isp' && (section.id === 'xgspon' || section.id === 'network')) || (slug === 'operators' && (section.id === 'europe' || section.id === 'wholesale'))) && <div class="pillars">{section.items?.map((item) => <article class="pillar" id={item.id}><h4>{item.title}</h4><ul>{(item.features ?? [item.body]).map((feature) => <li>{feature}</li>)}</ul></article>)}</div>}

        {section.kind === 'cards' && slug === 'isp' && section.id === 'operators' && <p style="text-align:center"><a class="btn btn--ghost btn--lg" href={section.items?.[0]?.href}>Operator solutions <span aria-hidden="true">→</span></a></p>}

        {section.kind === 'cards' && isInstallFeature && <div class="ref-grid">
          <div class="ref-media"><img src={`../${featureImages[`install:${section.id}`]}`} loading="lazy" alt={section.heading}></div>
          <div><h2>{section.heading}</h2>{section.lead && <p class="lead">{section.lead}</p>}<div class="feat-col" style="margin-top:22px">{section.items?.map((item) => <div class="f"><b>{item.title}</b><span>{item.body}</span></div>)}</div></div>
        </div>}

        {section.kind === 'cards' && isOperatorFeature && <div class="ref-grid">
          {section.id === 'volz' && <div class="ref-media"><img src={`../${featureImages['operators:volz']}`} loading="lazy" alt={section.heading}></div>}
          <div><h2>{section.heading}</h2>{section.lead && <p class="lead">{section.lead}</p>}<div class={section.id === 'volz' ? 'grid grid-2 en-feature-grid' : 'pillars en-feature-grid'}>{section.items?.map((item) => section.id === 'volz' ? <article class="card"><h4>{item.title}</h4><p>{item.body}</p></article> : <article class="pillar"><h4>{item.title}</h4><ul>{(item.features ?? [item.body]).map((feature) => <li>{feature}</li>)}</ul></article>)}</div></div>
          {section.id === 'colocation' && <div class="ref-media"><img src={`../${featureImages['operators:colocation']}`} loading="lazy" alt={section.heading}></div>}
        </div>}

        {section.kind === 'cards' && isCloudReference && <div class="ref-grid">
          <div class="ref-media"><img src={`../${featureImages['cloud:datacenter']}`} loading="lazy" alt={section.heading}></div>
          <div><h2>{section.heading}</h2>{section.lead && <p class="lead">{section.lead}</p>}{section.items?.map((item) => <p class="en-reference-note"><b>{item.title}.</b> {item.body}</p>)}</div>
        </div>}

        {section.kind === 'cards' && slug === 'kontakty' && section.id === 'contacts' && <div class="grid grid-3 en-contact-grid">{section.items?.map((item) => {
          const noteAfter = item.noteAfterLinks ?? 0;
          return <article class="contact-card"><h3>{item.title}</h3><p class="sub">{item.body}</p>{item.note && noteAfter === 0 && <p class="en-contact-note">{item.note}</p>}<div class="en-contact-links">{item.links?.map((link, index) => <><a href={link.href}>{link.label}</a>{item.note && noteAfter === index + 1 && <p class="en-contact-note en-contact-note--inline">{item.note}</p>}</>)}</div></article>;
        })}</div>}

        {section.kind === 'cards' && !(
          (slug === 'index' && ['segments-size', 'directions', 'pain', 'objects', 'chomu'].includes(section.id ?? '')) ||
          (section.id === 'directions') || (section.id === 'chomu') ||
          (segmentPages.has(slug) && ['details', 'services'].includes(section.id ?? '')) ||
          slug === 'poslugy' || (slug === 'taryfy' && section.id === 'operatory') ||
          (slug === 'isp' && ['xgspon', 'network', 'operators'].includes(section.id ?? '')) ||
          (slug === 'install' && isInstallFeature) || (slug === 'operators' && ['europe', 'volz', 'colocation', 'wholesale'].includes(section.id ?? '')) ||
          isCloudReference || (slug === 'kontakty' && section.id === 'contacts')
        ) && <div class={gridClass}>{section.items?.map((item) => <article class="card" id={item.id}><h3>{item.title}</h3><p>{item.body}</p>{item.href && <a class="link-arrow" href={item.href}>Explore <span class="ar" aria-hidden="true">→</span></a>}</article>)}</div>}

        {section.kind === 'plans' && <><div class="tariff-list">{section.items?.map((item) => <article class="trow">
          <div class="sp"><span class="plan">{item.title}</span><span class="val">{item.body.split(' ')[0]}<small>Mbps</small></span>{item.body.split(' · ')[2] && <span class="guar">{item.body.split(' · ')[2]}</span>}</div>
          <ul class="svc-list">{item.features?.map((feature) => <li>{feature}</li>)}</ul>
          <div class="buy"><span class="price">{item.body.split(' · ')[1]}</span><button class="btn btn--primary" data-modal data-mode="callback" data-tariff={item.title}>Request a consultation</button></div>
        </article>)}</div>{section.footnote && <p class="tariff-note">{section.footnote}</p>}</>}

        {section.kind === 'people' && <div class="mgr-grid">{section.items?.map((item) => <figure class="mgr"><div class="mgr-photo"><img class="mgr-img" src={`../${item.image}`} alt={item.title} loading="lazy"></div><figcaption class="mgr-cap"><b class="mgr-name">{item.title}</b><span class="mgr-role">{item.body}</span></figcaption></figure>)}</div>}

        {section.kind === 'gallery' && <div class="grid grid-3">{section.items?.map((item) => <div class="ref-media"><img data-zoom src={`../${item.image}`} alt={item.title} loading="lazy"></div>)}</div>}

        {section.kind === 'stats' && <div class="trustbar tb-5">{section.items?.map((item) => <div class="ti"><div class="num">{item.title}</div><div class="lbl">{item.body}</div></div>)}</div>}

        {section.kind === 'partners' && isIndexPartners && <><div class="ref-grid"><div class="ref-media"><img src="../img/team-datacenter.jpg" width="1536" height="1920" loading="lazy" alt="ASTRA engineers in the Lviv data center"></div><div><h2>{section.heading}</h2>{section.lead && <p class="lead">{section.lead}</p>}{section.note && <p class="en-reference-note">{section.note}</p>}</div></div><div class="partners partners--en" style="margin-top:clamp(36px,5vw,56px)">{partnerImages.map((name) => <span class:list={['partner', { 'partner--ugcc': name === 17 }]}><img src={`../img/partners/${name}.jpg`} alt={name === 17 ? 'Ukrainian Greek Catholic Church' : 'ASTRA client'} loading="lazy"></span>)}</div></>}

        {section.kind === 'partners' && !isIndexPartners && <div class={section.id === 'brands' ? 'brand-logos' : 'partners partners--en'}>{(section.id === 'brands' ? brandImages : partnerImages.slice(0, 16)).map((name) => <span class="partner"><img src={section.id === 'brands' ? `../img/brands/${name}.jpg` : `../img/partners/${name}.jpg`} alt={section.id === 'brands' ? String(name) : 'ASTRA client'} loading="lazy"></span>)}</div>}

        {section.kind === 'blog' && <><div class="blog-feature__head"><h2>{section.heading}</h2><a class="blog-all" href="blog/">All articles <span aria-hidden="true">→</span></a></div><div class="blog-grid">{latestPosts.map((post) => <BlogCard post={post} pathPrefix="../" sitePrefix="../en/" />)}</div></>}

        {section.kind === 'contact' && isContactConsult && <div class="consult-grid"><div class="consult-side"><h2>{section.heading}</h2>{section.lead && <p class="lead">{section.lead}</p>}<h3>Or message us</h3><div class="msg-row"><a class="msg-btn" href="https://t.me/astraispbot" target="_blank" rel="noopener">Telegram</a><a class="msg-btn" href="viber://chat?number=%2B380800203838" target="_blank" rel="noopener">Viber</a></div><p class="lead en-support-line">24/7 support: <a href="tel:+380800203838">0 800 20-38-38</a></p></div><div class="lead-card"><form data-lead style="display:flex;flex-direction:column;gap:14px">
          <input type="hidden" name="mode" value="consult"><div class="field"><label for={`${slug}-lead-name`}>Name / company</label><input id={`${slug}-lead-name`} type="text" name="name" autocomplete="organization" placeholder="Your name or company"></div><div class="field"><label for={`${slug}-lead-phone`}>Phone number</label><input id={`${slug}-lead-phone`} type="tel" data-phone name="phone" autocomplete="tel" inputmode="tel" placeholder="+38 (0__) ___-__-__" required aria-describedby={`${slug}-lead-phone-error`}><span class="err" id={`${slug}-lead-phone-error`} aria-live="polite"></span></div><div class="field"><label for={`${slug}-lead-address`}>Site address</label><input id={`${slug}-lead-address`} type="text" name="address" autocomplete="street-address" placeholder="City, street, building"></div><div class="field"><label for={`${slug}-lead-message`}>Tell us what you need</label><textarea id={`${slug}-lead-message`} name="message" rows="3" placeholder="Site type, services needed, approximate scale"></textarea></div><input type="hidden" name="tariff"><button class="btn btn--primary btn--block" type="submit">Send request</button><p class="form-note">By submitting this form, you agree to the processing of your data under our privacy policy.</p><div data-success style="display:none"><h4>Request received!</h4><p class="muted">Thank you! Our manager will contact you shortly.</p></div>
        </form></div></div>}

        {section.kind === 'contact' && !isContactConsult && <div class="lead-card" style="max-width:640px;margin-inline:auto"><form data-lead style="display:flex;flex-direction:column;gap:14px">
          <input type="hidden" name="mode" value="consult"><div class="field"><label for={`${slug}-lead-name`}>Name / company</label><input id={`${slug}-lead-name`} type="text" name="name" autocomplete="organization" placeholder="Your name or company"></div><div class="field"><label for={`${slug}-lead-phone`}>Phone number</label><input id={`${slug}-lead-phone`} type="tel" data-phone name="phone" autocomplete="tel" inputmode="tel" placeholder="+38 (0__) ___-__-__" required aria-describedby={`${slug}-lead-phone-error`}><span class="err" id={`${slug}-lead-phone-error`} aria-live="polite"></span></div><div class="field"><label for={`${slug}-lead-address`}>Site address</label><input id={`${slug}-lead-address`} type="text" name="address" autocomplete="street-address" placeholder="City, street, building"></div><div class="field"><label for={`${slug}-lead-message`}>Tell us what you need</label><textarea id={`${slug}-lead-message`} name="message" rows="3" placeholder="Site type, services needed, approximate scale"></textarea></div><input type="hidden" name="tariff"><button class="btn btn--primary btn--block" type="submit">Send request</button><p class="form-note">By submitting this form, you agree to the processing of your data under our privacy policy.</p><div data-success style="display:none"><h4>Request received!</h4><p class="muted">Thank you! Our manager will contact you shortly.</p></div>
        </form></div>}

        {section.note && !isIndexPartners && <p class="en-section-note">{section.note}</p>}
      </div>
    </section>;
  })}

  {page.cta && <section class="section tight"><div class="container"><div class="cta-band"><h2>{page.cta.title}</h2><p class="lead">{page.cta.text}</p><div class="row"><button class="btn btn--primary btn--lg" data-modal data-mode="consult">{page.cta.label ?? 'Request a consultation'}</button></div></div></div></section>}
</Layout>
