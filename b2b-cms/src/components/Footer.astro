---
const { pathPrefix = '', sitePrefix = pathPrefix, locale = 'uk' } = Astro.props;
const en = locale === 'en';
const link = (page: string) => `${sitePrefix}${page}`;
const cmsGuideHref = `${pathPrefix}cms-guide/`;
---
<footer class="site-footer">
  <div class="container footer-main">
    <div class="footer-brand">
      {en
        ? <div class="footer-brand-lockup" aria-label="ASTRA"><img src={`${pathPrefix}assets/logo-mark.svg`} alt=""><span>ASTRA</span></div>
        : <img src={`${pathPrefix}assets/logo.svg`} alt="АСТРА">
      }
      <p>{en ? 'A constellation of digital services. Building connectivity and security infrastructure since 2004.' : "Сузір'я цифрових послуг. Створюємо інфраструктуру зв'язку та безпеки з 2004 року."}</p>
      <div class="socials">
        <a href="https://t.me/astraisp" target="_blank" rel="noopener" aria-label="Telegram"><img src={`${pathPrefix}assets/soc-telegram.svg`} alt=""></a>
        <a href="https://www.youtube.com/@astra_in_ua" target="_blank" rel="noopener" aria-label="YouTube"><img src={`${pathPrefix}assets/soc-youtube.svg`} alt=""></a>
        <a href="https://instagram.com/astra_isp" target="_blank" rel="noopener" aria-label="Instagram"><img src={`${pathPrefix}assets/soc-instagram.svg`} alt=""></a>
        <a href="https://www.linkedin.com/company/astra-isp" target="_blank" rel="noopener" aria-label="LinkedIn"><img src={`${pathPrefix}assets/soc-linkedin.svg`} alt=""></a>
        <a href="https://www.facebook.com/astraisp" target="_blank" rel="noopener" aria-label="Facebook"><img src={`${pathPrefix}assets/soc-facebook.svg`} alt=""></a>
      </div>
    </div>
    <div><h5>{en ? 'Solutions' : 'Напрямки'}</h5>
      <a href={link('isp.html')}>{en ? 'ASTRA ISP, internet' : 'ASTRA ISP, інтернет'}</a><a href={link('install.html')}>{en ? 'ASTRA INSTALL, security & networks' : 'ASTRA INSTALL, безпека та мережі'}</a>
      <a href={link('cloud.html')}>{en ? 'ASTRA CLOUD, cloud & data center' : 'ASTRA CLOUD, хмара та ЦОД'}</a><a href={link('operators.html')}>{en ? 'For operators' : 'Для операторів'}</a>
      <a href={link('poslugy.html')}>{en ? 'All services' : 'Усі послуги'}</a>
    </div>
    <div><h5>{en ? 'By business size' : 'Рішення'}</h5>
      <a href={link('maliy.html')}>{en ? 'Small business' : 'Малий бізнес'}</a><a href={link('seredniy.html')}>{en ? 'Medium business' : 'Середній бізнес'}</a>
      <a href={link('velykyi.html')}>{en ? 'Large business' : 'Великий бізнес'}</a><a href={link('operators.html')}>{en ? 'Operators' : 'Оператори'}</a>
      <a href={link('taryfy.html')}>{en ? 'All plans' : 'Усі тарифи'}</a>
    </div>
    <div><h5>{en ? 'Company' : 'Компанія'}</h5>
      <a href={link('pro.html')}>{en ? 'About us' : 'Про нас'}</a><a href={link('blog/')}>{en ? 'Blog' : 'Блог'}</a><a href={link('kontakty.html')}>{en ? 'Contacts' : 'Контакти'}</a>
      <a href={cmsGuideHref}>{en ? 'CMS guide' : 'Гайд CMS'}</a>
      <a href="https://astra.in.ua" target="_blank" rel="noopener">{en ? 'Residential services ↗' : 'Приватним клієнтам ↗'}</a>
    </div>
    <div><h5>{en ? 'Portals ↗' : 'Сервіси ↗'}</h5>
      <a href="https://cabinet.astra.in.ua" target="_blank" rel="noopener">{en ? 'Customer portal' : 'Особистий кабінет'}</a>
      <a href="https://cloud.astra.in.ua" target="_blank" rel="noopener">Astra Cloud</a>
      <a href="https://speed.astra.in.ua" target="_blank" rel="noopener">{en ? 'Speed test' : 'Спідтест'}</a>
    </div>
  </div>
  <div class="container foot-bottom">
    <span>{en ? '© 2004–2026 ASTRA, ASTRA-LVIV LLC' : '© 2004–2026, компанія АСТРА, ТзОВ «АСТРА-ЛЬВІВ»'}</span>
    <span>{en ? 'Building connectivity and security infrastructure since 2004' : "Створюємо інфраструктуру зв'язку та безпеки з 2004 року"}</span>
  </div>
</footer>
