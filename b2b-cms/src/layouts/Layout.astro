---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LeadModal from '../components/LeadModal.astro';
import MobileMenu from '../components/MobileMenu.astro';

export interface Props {
  title: string;
  description: string;
  canonical: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  bodyClass?: string;
  leadSource?: string;
  pathPrefix?: string;
  locale?: 'uk' | 'en';
  alternatePath?: string;
}
const {
  title,
  description,
  canonical,
  ogTitle,
  ogDescription,
  ogImage = 'https://astra.in.ua/b2b/img/og-cover.jpg',
  bodyClass = 'page-b2b ctx-biz mode-biz',
  leadSource,
  pathPrefix = '',
  locale = 'uk',
  alternatePath,
} = Astro.props;
const leadEndpoint = import.meta.env.PUBLIC_LEAD_ENDPOINT || '';
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';
const path = Astro.url.pathname.replace(/^\/b2b\//, '/');
// Vercel rewrites these .html URLs to directory routes before Astro sees them.
const flatPages = new Set(['maliy', 'seredniy', 'velykyi', 'operators', 'isp', 'install', 'cloud', 'poslugy', 'taryfy', 'pro', 'kontakty']);
const directoryPage = path.match(/^\/([^/]+)\/$/);
const pagePath = directoryPage && flatPages.has(directoryPage[1]) ? `/${directoryPage[1]}.html` : path;
const equivalentPath = alternatePath ?? (locale === 'en' ? pagePath.replace(/^\/en\//, '/') : pagePath === '/' || pagePath === '/index.html' ? '/en/' : `/en${pagePath}`);
const ukPath = locale === 'uk' ? pagePath : equivalentPath;
const enPath = locale === 'en' ? pagePath : equivalentPath;
const sitePrefix = `${pathPrefix}${locale === 'en' ? 'en/' : ''}`;
const mountPath = Astro.url.pathname.startsWith('/b2b/') ? '/b2b' : '';
const languageHref = `${mountPath}${equivalentPath}`;
---
<!DOCTYPE html>
<html lang={locale}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#07152e">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<link rel="alternate" hreflang="uk" href={`https://astra.in.ua/b2b${ukPath}`}>
<link rel="alternate" hreflang="en" href={`https://astra.in.ua/b2b${enPath}`}>
<link rel="icon" href={`${pathPrefix}assets/favicon.ico`} sizes="any">

<meta property="og:type" content="website">
<meta property="og:locale" content={locale === 'en' ? 'en_US' : 'uk_UA'}>
<meta property="og:site_name" content={locale === 'en' ? 'ASTRA, digital services for business' : "АСТРА, Сузір'я цифрових послуг"}>
<meta property="og:title" content={ogTitle ?? title}>
<meta property="og:description" content={ogDescription ?? description}>
<meta property="og:image" content={ogImage}>
<meta name="twitter:card" content="summary_large_image">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Wix+Madefor+Display:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href={`${pathPrefix}css/astra.css`}>
<link rel="stylesheet" href={`${pathPrefix}css/b2b.css`}>
<link rel="stylesheet" href={`${pathPrefix}css/blog.css`}>
<slot name="head" />
</head>
<body class={bodyClass} data-lead-source={leadSource} data-lead-endpoint={leadEndpoint} data-turnstile-sitekey={turnstileSiteKey}>
<a class="skip-link" href="#main-content">{locale === 'en' ? 'Skip to content' : 'Перейти до вмісту'}</a>
<Header pathPrefix={pathPrefix} sitePrefix={sitePrefix} locale={locale} alternateHref={languageHref} />
<main id="main-content" tabindex="-1">
  <slot />
</main>
<Footer pathPrefix={pathPrefix} sitePrefix={sitePrefix} locale={locale} />
<LeadModal locale={locale} />
<MobileMenu sitePrefix={sitePrefix} locale={locale} alternateHref={languageHref} />
<div class="lightbox" role="dialog" aria-modal="true" aria-hidden="true" aria-label={locale === 'en' ? 'Image preview' : 'Перегляд зображення'} inert>
  <button class="lightbox-close" type="button" data-close-lightbox aria-label={locale === 'en' ? 'Close image preview' : 'Закрити перегляд'}>✕</button>
  <img src="" alt="">
</div>
<script src={`${pathPrefix}js/astra.js`} defer is:inline></script>
<script src={`${pathPrefix}js/motion.js`} defer is:inline></script>
</body>
</html>
